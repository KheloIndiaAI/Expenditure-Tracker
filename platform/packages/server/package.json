{
  "name": "@efip/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --no-warnings --watch src/main.ts",
    "start": "node --experimental-strip-types --no-warnings src/main.ts",
    "seed": "node --experimental-strip-types --no-warnings src/scripts/seed.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@efip/shared": "*",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
