{
  "name": "@efip/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --experimental-strip-types --experimental-sqlite --no-warnings --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env --experimental-strip-types --experimental-sqlite --no-warnings src/main.ts",
    "seed": "node --env-file-if-exists=../../.env --experimental-strip-types --experimental-sqlite --no-warnings src/scripts/seed.ts",
    "seed:users": "node --env-file-if-exists=../../.env --experimental-strip-types --experimental-sqlite --no-warnings src/scripts/seed-users.ts",
    "seed:super": "node --env-file-if-exists=../../.env --experimental-strip-types --experimental-sqlite --no-warnings src/scripts/seed-super-admin.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file-if-exists=../../.env --experimental-strip-types --experimental-sqlite --no-warnings --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@efip/shared": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.9.0 <23"
  }
}
