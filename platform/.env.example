# ─────────────────────────────────────────────────────────────────────────────
#  EFIP server — sample environment. Copy to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL=12h
COOKIE_NAME=efip_session

# ── Database ─────────────────────────────────────────────────────────────────
# Production (App Runner + Amazon RDS): set DATABASE_URL and the Postgres driver
# is used automatically. Leave it UNSET for local dev to fall back to SQLite.
#   DATABASE_URL=postgres://efip_app:<password>@<rds-endpoint>:5432/efip
#   PGSSL_STRICT=true          # set once the RDS CA bundle is trusted (verify-full)
# Local dev (SQLite) — only used when DATABASE_URL is unset:
EFIP_DB=/var/lib/efip/efip.db

# ── Initial admin login (used by `npm run seed`) ─────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Administrator
ADMIN_ROLE=admin
ADMIN_DESIGNATION=Platform Administrator

# ── Bulk RC-user seed (used by `npm run seed:users`) ─────────────────────────
# Path to the gitignored CSV of Regional-Centre logins (username,name,role,designation,password).
SEED_USERS_CSV=./seed/rc_users.csv

# ── Optional path overrides (defaults are usually correct) ───────────────────
# WEB_DIST=/opt/efip/platform/packages/web/dist
# DASHBOARD_HTML=/opt/efip/platform/public/index.html
