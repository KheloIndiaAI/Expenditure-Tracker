# ─────────────────────────────────────────────────────────────────────────────
#  EFIP server — sample environment.
#  Copy to `.env` (in this platform/ folder) and fill in real values:
#     cp .env.example .env
#  The server auto-loads ../../.env relative to packages/server at run time.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a long random secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL=12h
COOKIE_NAME=efip_session

# ── Database (SQLite — holds ONLY login users) ───────────────────────────────
# The financial data is read live from the Google Sheet by the dashboard; it is
# never stored here. Use an absolute path on the server for durability.
EFIP_DB=/var/lib/efip/efip.db

# ── Initial admin login (used by `npm run seed`) ─────────────────────────────
ADMIN_EMAIL=admin@sai.gov.in
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Administrator
ADMIN_ROLE=admin
ADMIN_DESIGNATION=Platform Administrator

# ── Optional path overrides (defaults are usually correct) ───────────────────
# WEB_DIST=/opt/efip/platform/packages/web/dist
# DASHBOARD_HTML=/opt/efip/platform/public/index.html
